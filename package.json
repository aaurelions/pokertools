{
  "name": "pokertools-monorepo",
  "version": "2.0.2",
  "private": true,
  "description": "Enterprise-grade Texas Hold'em poker engine and API monorepo",
  "author": "A.Aurelius",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aaurelions/pokertools.git"
  },
  "bugs": {
    "url": "https://github.com/aaurelions/pokertools/issues"
  },
  "homepage": "https://github.com/aaurelions/pokertools#readme",
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=12.2.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "npm install",
    "build": "npm run build -w @pokertools/types && npm run build -w @pokertools/evaluator && npm run build -w @pokertools/engine && npm run build -w @pokertools/api && npm run build -w @pokertools/custody && npm run build -w @pokertools/sdk",
    "build:watch": "tsc -b --watch",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "test": "npm run test --workspaces --if-present",
    "test:quick": "npm run test --workspace @pokertools/engine -- --silent && npm run test --workspace @pokertools/evaluator -- --silent && npm run test --workspace @pokertools/types -- --silent && npm run test --workspace @pokertools/sdk -- --reporter=dot",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "lint": "eslint . --ext .ts --max-warnings 30",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "typecheck": "tsc -b && tsc --noEmit -p packages/e2e/tsconfig.json && tsc --noEmit -p packages/bench/tsconfig.json",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "check:publish": "node scripts/check-publish-contents.mjs",
    "validate": "npm run format:check && npm run lint && npm test",
    "precommit": "npm run format:check && npm run lint && npm run test:quick",
    "prepare": "git config core.hooksPath .githooks && npm run db:generate:prepare -w @pokertools/api --if-present && tsc -b",
    "dev:api": "npm run dev -w @pokertools/api",
    "dev:workers": "npm run workers -w @pokertools/api",
    "start:api": "npm start -w @pokertools/api",
    "bench": "npm run bench -w @pokertools/bench",
    "redis": "redis-server",
    "db:migrate": "npm run db:migrate -w @pokertools/api",
    "db:seed": "npm run db:seed -w @pokertools/api",
    "ci": "npm run clean && npm run setup && npm run test",
    "e2e:docker": "npm run test:docker -w @pokertools/e2e",
    "e2e:finance": "bash scripts/run-finance-acceptance.sh",
    "e2e:production": "bash scripts/run-production-acceptance.sh",
    "build:production:acceptance": "docker build -t ghcr.io/aaurelions/pokertools:production-acceptance .",
    "deploy:prod": "docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build",
    "deploy:prod:down": "docker compose --env-file .env.production -f docker-compose.prod.yml down",
    "deploy:prod:logs": "docker compose --env-file .env.production -f docker-compose.prod.yml logs -f",
    "deploy:prod:ps": "docker compose --env-file .env.production -f docker-compose.prod.yml ps",
    "db:backup": "docker compose --env-file .env.production -f docker-compose.prod.yml exec backup sh /backup.sh",
    "db:restore:test": "docker compose --env-file .env.production -f docker-compose.prod.yml exec backup sh -c \"BACKUP_DIR=/backups /deploy/postgres-restore-test.sh\""
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/redlock": "^4.0.8",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^18.0.5",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "pino": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "prettier-plugin-solidity": "^2.4.1",
    "prisma": "7.10.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "overrides": {
    "@prisma/config@7.10.0": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma@7.10.0": {
      "mysql2": "3.24.5"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@prisma/engines@7.10.0": true,
    "@swc/core@1.16.13": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true,
    "better-sqlite3@13.0.3": true,
    "better-sqlite3@12.11.1": true
  }
}
