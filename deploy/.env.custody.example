# =============================================================================
# PokerTools custody signing environment — CUSTODY SERVICE ONLY
#
# Copy to `.env.custody` (repository root) for production:
#   cp deploy/.env.custody.example .env.custody
#
# SECURITY: this file is read ONLY by the `custody` service in
# docker-compose.prod.yml. It must never be passed to the public API, worker or
# Caddy service. Keep it out of version control and restrict its permissions
# (chmod 600).
#
# Custody signs with per-chain treasury keys. Do not include API authentication
# secrets or unrelated signing/decryption material.
# =============================================================================

# JSON object mapping chainId to a 0x-prefixed 32-byte treasury signing key,
# e.g. {"1":"0xabc...","8453":"0xdef..."}.
# Required in production. Empty permits monitoring-only in development/test.
TREASURY_SIGNING_KEYS_JSON=

# Worker cadence and quorum. Defaults in the compose environment are used when
# a field is omitted here.
CUSTODY_WORKER_INTERVAL_MS=5000
CUSTODY_RECONCILE_INTERVAL_MS=300000
CUSTODY_QUORUM_THRESHOLD=2
CUSTODY_MIN_QUORUM=2

# Database is supplied by the compose environment map; do not set it
# here unless you are intentionally overriding the internal service names.
# DATABASE_URL=postgresql://pokertools:...@postgres:5432/pokertools
