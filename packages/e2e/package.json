{
  "name": "@pokertools/e2e",
  "version": "2.1.2",
  "description": "End-to-end Docker integration tests for PokerTools API",
  "author": "A.Aurelius",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=12.2.0"
  },
  "scripts": {
    "pretest:docker": "echo '🐳 Building Docker E2E dependencies...' && npm run build -w @pokertools/types && npm run build -w @pokertools/sdk && npm run contracts:build -w @pokertools/custody --if-present",
    "test:docker": "NODE_ENV=test vitest run --config vitest.config.ts",
    "contracts:build:finance": "npm run contracts:build -w @pokertools/custody",
    "test:finance-acceptance": "vitest run --config vitest.finance.config.ts"
  },
  "dependencies": {
    "@pokertools/sdk": "2.1.2",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "better-sqlite3": "^13.2.0",
    "bullmq": "^6.7.10",
    "dotenv": "^18.0.10",
    "fast-jwt": "^6.3.7",
    "ioredis": "^6.1.0",
    "viem": "^2.58.6",
    "vitest": "^5.1.1",
    "ws": "^8.23.0"
  }
}
