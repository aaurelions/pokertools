# shellcheck shell=sh disable=SC2034,SC2209
# ── Environment ────────────────────────────────────
NODE_ENV=development

# ── Infrastructure ──────────────────────────────────
DATABASE_URL=file:../.runtime/dev.db
REDIS_URL=redis://localhost:6379
DEFAULT_CURRENCY=USDC

# ── Wallet Configuration (Docker Secrets supported) ─
MASTER_MNEMONIC=your twelve word mnemonic phrase goes here for testing only
# MASTER_MNEMONIC_FILE=/run/secrets/master_mnemonic
HOT_WALLET_DERIVATION_PATH="m/44'/60'/0'/0/0"

# ── Smart Contracts (Deployed Addresses) ────────────
BATCH_SWEEPER_ADDRESS_MAINNET=
BATCH_SWEEPER_ADDRESS_POLYGON=
BATCH_SWEEPER_ADDRESS_LOCAL=
# JSON map overriding per-chain sweeper addresses, e.g. {"1":"0x…","137":"0x…"}
# SWEEPER_CONTRACT_MAP=

# ── Telegram ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_chat_id_here

# ── Operational Thresholds ──────────────────────────
MAX_GAS_PRICE_GWEI=50
MIN_SWEEP_VALUE_RAW_UNITS=10
LOW_GAS_THRESHOLD_ETH=0.1

# ── RPC Resilience ──────────────────────────────────
RPC_RETRY_COUNT=3
RPC_RETRY_DELAY_MS=1000
RPC_TIMEOUT_MS=10000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_OPEN_MS=30000
WITHDRAWAL_SIGNATURE_MAX_AGE_MS=300000

# ── Polling / Scan Intervals ────────────────────────
SWEEP_INTERVAL_MS=600000
GAS_MONITOR_INTERVAL_MS=1800000
TRANSACTION_MONITOR_INTERVAL_MS=60000
WITHDRAWAL_POLL_INTERVAL_MS=3000
RECOVERY_SCAN_INTERVAL_MS=300000
STUCK_WITHDRAWAL_MAX_AGE_MS=21600000

# ── Velocity Limits (Risk Management) ───────────────
MAX_SINGLE_WITHDRAWAL_USD=5000
MAX_DAILY_WITHDRAWAL_USD=50000

# ── Security ────────────────────────────────────────
WALLET_ENCRYPTION_SECRET=CHANGE_THIS_IN_PRODUCTION
WALLET_XPRIV_ENCRYPTION_SECRET=CHANGE_THIS_IN_PRODUCTION_WITH_A_DIFFERENT_SECRET
JWT_SECRET=CHANGE_THIS_IN_PRODUCTION
PBKDF2_ITERATIONS=600000

# ── Logging ─────────────────────────────────────────
LOG_LEVEL=info
