{
  "name": "@pokertools/api",
  "version": "2.0.4",
  "description": "Production-ready REST/WebSocket API for PokerTools engine",
  "author": "A.Aurelius",
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "exports": {
    "./finance-core": {
      "types": "./dist/finance-core.d.ts",
      "import": "./dist/finance-core.js"
    },
    "./database": {
      "types": "./generated/prisma/index.d.ts",
      "import": "./generated/prisma/index.js"
    }
  },
  "private": true,
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist generated coverage .runtime node_modules",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "infra:up": "bash scripts/ensure-redis.sh",
    "infra:down": "bash scripts/stop-redis.sh",
    "db:generate": "prisma generate",
    "db:generate:prepare": "node scripts/generate-prisma-for-prepare.js",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "db:migrate:postgres": "node scripts/migrate-postgres.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "db:ensure:test": "NODE_ENV=test bash scripts/ensure-db.sh",
    "pretest": "npm run db:ensure:test",
    "test": "NODE_ENV=test vitest run --config vitest.config.ts",
    "pretest:coverage": "npm run db:ensure:test",
    "test:coverage": "NODE_ENV=test vitest run --config vitest.config.ts --coverage",
    "test:stand-alone": "npm run infra:up && npm run test; npm run infra:down",
    "test:postgres:migrations": "node --test tests/acceptance/postgres-migrations.test.mjs",
    "test:postgres:ledger": "node --test tests/acceptance/atomic-ledger-pg.test.mjs",
    "test:production": "node --test tests/acceptance/production-admission.test.mjs",
    "test:loopback": "NODE_ENV=test POKERTOOLS_LOOPBACK_TEST=true vitest run --config vitest.config.ts",
    "test:browser": "node tests/loopback/browser/run.mjs",
    "test:canonical": "NODE_ENV=test vitest run --config tests/acceptance/canonical/vitest.acceptance.config.ts",
    "start": "node dist/server.js",
    "start:workers": "node dist/workers.js",
    "dev": "tsx watch src/server.ts",
    "workers": "tsx watch src/workers.ts"
  },
  "keywords": [
    "poker",
    "api",
    "websocket",
    "fastify",
    "engine",
    "rest",
    "real-time",
    "redis",
    "postgresql"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aaurelions/pokertools.git",
    "directory": "packages/api"
  },
  "homepage": "https://github.com/aaurelions/pokertools/tree/main/packages/api#readme",
  "bugs": {
    "url": "https://github.com/aaurelions/pokertools/issues"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=12.2.0"
  },
  "devDependencies": {
    "@pokertools/sdk": "2.0.4",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/websocket": "^11.3.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@pokertools/engine": "2.0.4",
    "@pokertools/types": "2.0.4",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^13.0.3",
    "bullmq": "^6.3.11",
    "dotenv": "^18.0.5",
    "envalid": "^8.2.0",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "redlock": "^4.2.0",
    "viem": "^2.57.2",
    "zod": "^4.6.5"
  }
}
