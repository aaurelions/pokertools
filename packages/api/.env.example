# shellcheck shell=sh disable=SC2034,SC2209
# Environment Configuration for @pokertools/api
# Copy this file to .env and update with your values

# ── Application ─────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ── Database ────────────────────────────────────────
# Development (SQLite) - path is relative to prisma/schema.prisma
DATABASE_URL="file:../.runtime/dev.db"
# Production (PostgreSQL) - uncomment and configure for production
# DATABASE_URL="postgresql://user:password@localhost:5432/poker"

# ── Redis ───────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Security (generate with: openssl rand -base64 32) ──
JWT_SECRET="CHANGE_THIS_IN_PRODUCTION"
COOKIE_SECRET="CHANGE_THIS_IN_PRODUCTION"
ALLOWED_SIWE_CHAIN_IDS="1,31337"
SESSION_TTL_SECONDS=604800
NONCE_TTL_SECONDS=300

# ── CORS & Observability ────────────────────────────
# CORS_ORIGIN must be set in production (empty = deny cross-origin)
CORS_ORIGIN=""
# Bearer token required for /metrics in production; unset disables the endpoint
METRICS_TOKEN=""
# Explicit opt-in for test-only routes; never enable outside isolated tests
ENABLE_TEST_ROUTES="false"

# ── Rate Limiting ───────────────────────────────────
RATE_LIMIT_MAX=100
AUTH_NONCE_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_MAX=10

# ── Game & Table ────────────────────────────────────
TABLE_REDIS_TTL_SECONDS=86400
TABLE_LOCK_TTL_MS=10000
TABLE_LOCK_TTL_MS_TEST=15000
ACTION_TIMEOUT_SECONDS=30
AUTO_DEAL_DELAY_MS=5000
TABLE_LISTING_PAGE_SIZE=50

# ── Financial & Risk Controls ───────────────────────
RISK_SCORE_THRESHOLD=70
RISK_WITHDRAW_USER_LIMIT=5
RISK_BUY_IN_USER_LIMIT=12
RISK_ACTION_USER_LIMIT=60
RISK_WITHDRAW_IP_LIMIT=20
RISK_BUY_IN_IP_LIMIT=40
RISK_ACTION_IP_LIMIT=200
RISK_SCORING_WINDOW_MS=60000
RISK_USER_COUNT_THRESHOLD=20
RISK_USER_COUNT_SCORE=40
RISK_IP_COUNT_THRESHOLD=80
RISK_IP_COUNT_SCORE=25
RISK_MEDIUM_AMOUNT_CENTS_THRESHOLD=100000
RISK_MEDIUM_AMOUNT_CENTS_SCORE=20
RISK_HIGH_AMOUNT_CENTS_THRESHOLD=500000
RISK_HIGH_AMOUNT_CENTS_SCORE=30
IDEMPOTENCY_TTL_SECONDS=3600

# ── Tournament ──────────────────────────────────────
TOURNAMENT_BLIND_INTERVAL_MS=900000
TOURNAMENT_BLIND_SCAN_INTERVAL_MS=15000
TOURNAMENT_LOCK_TTL_MS=30000
TOURNAMENT_LISTING_PAGE_SIZE=100
MAX_TOURNAMENT_TABLES=10
RECONCILIATION_INTERVAL_MS=300000
RECONCILIATION_BATCH_SIZE=100

# ── Distributed Locking ─────────────────────────────
REDLOCK_RETRY_COUNT=50
REDLOCK_RETRY_COUNT_TEST=5000
REDLOCK_RETRY_DELAY_MS=100
REDLOCK_RETRY_DELAY_MS_TEST=2
REDLOCK_RETRY_JITTER_MS=100
REDLOCK_RETRY_JITTER_MS_TEST=2
REDLOCK_DRIFT_FACTOR=0.01

# ── WebSocket ───────────────────────────────────────
WS_MAX_CONNECTIONS_PER_USER=4
WS_MAX_PRE_AUTH_QUEUE=32
WS_HEARTBEAT_INTERVAL_MS=30000
