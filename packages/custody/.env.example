# shellcheck shell=sh disable=SC2034,SC2209
# ── Environment ────────────────────────────────────
NODE_ENV=development

# ── Infrastructure ──────────────────────────────────
DATABASE_URL=file:../.runtime/dev.db
REDIS_URL=redis://localhost:6379

# ── Canonical custody worker ────────────────────────
# Per-chain treasury signing keys as a JSON object of chainId -> 0x private key.
# Kept in custody only; the API process rejects this name. Leave empty to run
# monitoring-only (signing then fails closed).
TREASURY_SIGNING_KEYS_JSON=
CUSTODY_WORKER_INTERVAL_MS=5000
CUSTODY_RECONCILE_INTERVAL_MS=300000
CUSTODY_QUORUM_THRESHOLD=2
CUSTODY_MIN_QUORUM=2

# ── Logging ─────────────────────────────────────────
LOG_LEVEL=info
