{
  "name": "@pokertools/custody",
  "version": "1.0.20",
  "description": "Fund aggregation (sweeper) and withdrawal processing service",
  "author": "A.Aurelius",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist coverage cache node_modules contracts/out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "contracts:build": "forge build",
    "contracts:test": "forge test",
    "db:prepare": "npm run db:ensure:test --workspace=@pokertools/api",
    "test": "vitest run tests/core tests/process-safety.test.ts",
    "test:workflow": "vitest run tests/core/withdrawal-workflow.test.ts",
    "typecheck:workflow": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "keywords": [
    "poker",
    "custody",
    "blockchain",
    "sweeper",
    "withdrawal",
    "telegram"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@pokertools/api": "1.0.20",
    "@pokertools/types": "1.0.20",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.5",
    "envalid": "^8.2.0",
    "grammy": "^1.46.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "viem": "^2.57.2"
  }
}
